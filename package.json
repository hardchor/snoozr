{
  "name": "snoozr",
  "displayName": "Snoozr",
  "description": "Snoozr is a Chrome extension that allows you to snooze tabs until a specific time or date.",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:zip": "node scripts/build-zip.js",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky || true",
    "bump-and-build": "tsx scripts/bump-and-build.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-router": "1.170.19",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "daisyui": "^5.7.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.3.0",
    "postcss": "8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.20.0"
  }
}
